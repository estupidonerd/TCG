# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.
# Ninguna URL ni clave de Supabase va en el código: todo sale de acá.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca llega al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# "test" SOLO en el despliegue que apunta al proyecto de Pruebas (por ejemplo,
# la vista previa de Vercel). En producción déjala vacía o no la definas:
# activa la sección "Reloj de pruebas" de /admin/ajustes.
NEXT_PUBLIC_APP_ENV=
